# Backend
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=change-this-to-a-long-random-secret

# Comma separated frontend domains allowed by CORS
FRONTEND_URL=http://localhost:3000,https://linkflo.club,https://www.linkflo.club

# Public backend URL used for uploaded image URLs
PUBLIC_BASE_URL=http://localhost:5000

# Billplz credit topup
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_CALLBACK_URL=
BILLPLZ_REDIRECT_URL=

# Required for AI Generate. If empty, AI Generate returns an error and does not deduct credit.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
